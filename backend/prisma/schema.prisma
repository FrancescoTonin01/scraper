generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CarListing {
  id           String   @id @default(cuid())
  source       String   // 'autoscout' | 'subito'
  title        String
  price        Int?
  mileage      Int?
  year         Int?
  fuel         String?
  transmission String?
  city         String?
  imageUrl     String?
  originalUrl  String
  searchId     String?
  createdAt    DateTime @default(now())

  search SearchQuery? @relation(fields: [searchId], references: [id])

  @@index([searchId])
}

model SearchQuery {
  id        String       @id @default(cuid())
  make      String
  model     String
  location  String?
  radius    Int?
  createdAt DateTime     @default(now())
  listings  CarListing[]
}

model AlertSubscription {
  id        String   @id @default(cuid())
  email     String
  make      String
  model     String
  location  String?
  radius    Int?
  yearFrom  Int?
  yearTo    Int?
  kmMax     Int?
  fuel      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([active])
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int
  message   String?
  page      String?
  createdAt DateTime @default(now())
}
